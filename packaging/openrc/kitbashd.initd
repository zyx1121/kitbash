#!/sbin/openrc-run
# kitbashd: the OTLP receiver and Telemetry store, see PLAN.md section 4.1.
# It listens on one unix socket, where the caller is read from the peer
# credentials, and on TCP 4318, the Process receiver, where the caller is the
# bearer token kitbashd minted at registration. The host firewall scopes who
# may reach that port; nothing here installs one.

name="kitbashd"
description="kitbash daemon: OTLP receiver and Telemetry store"

supervisor="supervise-daemon"
command="/usr/bin/kitbashd"
pidfile="/run/kitbash/kitbashd.pid"
output_log="/var/log/kitbashd.log"
error_log="/var/log/kitbashd.log"
respawn_delay=5
respawn_max=0
# The window respawn_max would count in. With respawn_max at 0 nothing is ever
# given up on, and this is what keeps a daemon that fails in a loop from being
# restarted as fast as it can exit: five minutes of failures are counted
# together rather than each one starting the count again.
respawn_period=300

# supervise-daemon runs healthcheck() every healthcheck_timer seconds and
# restarts kitbashd when it fails, which respawn_max=0 then keeps doing for as
# long as the host is up. A daemon that is running but no longer answering is
# the outage that matters: Processes start untraced, members cannot write /org
# and /mcp is gone, see PLAN.md section 4.5 and issue #67. The first check
# waits for the store to open and the listeners to bind.
healthcheck_timer=60
healthcheck_delay=60

# One connection per member session, plus room for the exports in flight. The
# daemon caps itself at 256 connections; this is the kernel's matching bound.
rc_ulimit="-n 1024"

depend() {
	# The socket needs a filesystem. The Process receiver binds every address,
	# which works before the network is configured, so net is a preference and
	# not a requirement: a host whose network is down still stores the
	# Telemetry of the sessions on it.
	need localmount
	# The unified hierarchy has to be mounted before kitbashd can create
	# /sys/fs/cgroup/kitbash and delegate memory, cpu and pids to one cgroup
	# per member, which is where a Process's limits are enforced.
	need cgroups
	use net
	# Nothing here waits for local. The rootless prerequisites boot restore
	# needs used to come from /etc/local.d/kitbash-rootless.start, so this
	# was after local, but deploy/install.sh may itself run from local.d,
	# where its rc-service kitbashd restart then waited for the runlevel it
	# was part of: a deadlock that took the console with it, see issue #88.
	# start_pre runs those prerequisites instead.
}

healthcheck() {
	# GET /kitbash/v1/health over the unix socket, which is the surface every
	# member reaches the daemon through, so this asks the same question a
	# session asks. curl is on the host, deploy/install.sh installs it. root
	# is a peer credential like any other, so the daemon answers it.
	curl --silent --show-error --fail --max-time 5 \
		--unix-socket /run/kitbash/kitbashd.sock \
		http://localhost/kitbash/v1/health >/dev/null
}

start_pre() {
	# The socket directory is world traversable; the socket itself is
	# root:kitbash-users 0660 and kitbashd sets that after it binds.
	checkpath --directory --mode 0755 --owner root:root /run/kitbash
	# The store holds every member's Telemetry, so only root reads it.
	checkpath --directory --mode 0700 --owner root:root /var/lib/kitbash
	# A backup is a copy of that store, so it is kept the same way. kitbashd
	# creates this directory too; doing it here also narrows one that an
	# earlier layout left looser, see PLAN.md section 4.7.
	checkpath --directory --mode 0700 --owner root:root /var/lib/kitbash/backup
	checkpath --file --mode 0640 --owner root:root /var/log/kitbashd.log
	# / rshared and one /run/user directory per member, both of which live in
	# tmpfs and are gone after a reboot. Boot restore starts each registered
	# Process as its owner and needs them, see PLAN.md section 2.3. Doing it
	# here rather than depending on local is what keeps this daemon startable
	# from a local.d script, see issue #88. A host that has the binary but
	# not the shared script still starts, because a daemon is more use than
	# no daemon, but it says so: what follows is Processes that do not come
	# back and a member who cannot run one.
	if [ -x /usr/share/kitbash/rootless-prereqs.sh ]; then
		/usr/share/kitbash/rootless-prereqs.sh
	else
		ewarn "/usr/share/kitbash/rootless-prereqs.sh is missing; / is not rshared and no /run/user directory is made, so Processes will not restore"
	fi
}
